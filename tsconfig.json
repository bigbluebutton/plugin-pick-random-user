{
    "compilerOptions": {
        "outDir": "./dist-tsc/",
        "noImplicitAny": true,
        "skipLibCheck": true,
        "module": "ES2022",
        "target": "ES2022",
        "lib": ["ES2022", "DOM"],
        "jsx": "react",
        "allowJs": true,
        "moduleResolution": "node",
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true
    },
    "include": ["src/*", "public/locales/*"],
    "exclude": [
        "node_modules"
    ]
}
